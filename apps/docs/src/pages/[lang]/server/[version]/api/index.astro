---
import ServerApiIndex from '../../../../../components/reference/ServerApiIndex.astro'
import DocsLayout from '../../../../../layouts/DocsLayout.astro'
import {
  loadServerVersions,
  type ServerDocsArtifact,
  type ServerVersionsModel,
} from '../../../../../lib/docs-model'
import { versionContext } from '../../../../../lib/server-version'

export async function getStaticPaths() {
  const model = await loadServerVersions()
  return model.versions.flatMap((artifact) =>
    (['en', 'ja'] as const).map((lang) => ({
      params: { lang, version: artifact.release.version },
      props: { lang, artifact, model },
    })),
  )
}

interface Props {
  lang: 'en' | 'ja'
  artifact: ServerDocsArtifact
  model: ServerVersionsModel
}
const { lang, artifact, model } = Astro.props
const title = lang === 'en' ? 'Server API' : 'Server APIリファレンス'
const description = `${artifact.references.api.operations.length} OpenAPI operations`
const basePath = `/${lang}/server/${artifact.release.version}/api`
---

<DocsLayout
  lang={lang}
  title={title}
  description={description}
  server={versionContext(artifact, model)}
>
  <ServerApiIndex lang={lang} model={artifact.references.api} basePath={basePath} />
</DocsLayout>

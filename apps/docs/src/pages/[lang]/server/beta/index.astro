---
import { loadServerVersions } from '../../../../lib/docs-model'

export async function getStaticPaths() {
  const model = await loadServerVersions()
  if (!model.aliases.beta) return []
  return (['en', 'ja'] as const).map((lang) => ({
    params: { lang },
    props: { lang, version: model.aliases.beta },
  }))
}

const { lang, version } = Astro.props
const destination = `/${lang}/server/${version}`
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8">
    <meta name="robots" content="noindex">
    <meta http-equiv="refresh" content={`0;url=${destination}`}>
    <link rel="canonical" href={new URL(destination, Astro.site)}>
    <title>Shumoku Server beta</title>
  </head>
  <body>
    <a href={destination}>Shumoku Server {version}</a>
  </body>
</html>

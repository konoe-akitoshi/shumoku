{
  "id": "network-multiport",
  "version": "1.0",
  "nodes": [
    {
      "id": "node-switch",
      "label": "access-switch",
      "metadata": { "device.role": "switch" },
      "ports": [
        { "id": "port-switch-a", "label": "Ethernet1", "interfaceName": "Ethernet1" },
        { "id": "port-switch-b", "label": "Ethernet2", "interfaceName": "Ethernet2" },
        { "id": "port-switch-c", "label": "Ethernet3", "interfaceName": "Ethernet3" }
      ]
    },
    {
      "id": "node-a",
      "label": "server-a",
      "metadata": { "device.role": "server" },
      "ports": [{ "id": "port-a", "label": "eth0", "interfaceName": "eth0" }]
    },
    {
      "id": "node-b",
      "label": "server-b",
      "metadata": { "device.role": "server" },
      "ports": [{ "id": "port-b", "label": "eth0", "interfaceName": "eth0" }]
    },
    {
      "id": "node-c",
      "label": "server-c",
      "metadata": { "device.role": "server" },
      "ports": [{ "id": "port-c", "label": "eth0", "interfaceName": "eth0" }]
    }
  ],
  "links": [
    {
      "id": "connection-a",
      "from": { "node": "node-switch", "port": "port-switch-a" },
      "to": { "node": "node-a", "port": "port-a" },
      "metadata": {}
    },
    {
      "id": "connection-b",
      "from": { "node": "node-switch", "port": "port-switch-b" },
      "to": { "node": "node-b", "port": "port-b" },
      "metadata": {}
    },
    {
      "id": "connection-c",
      "from": { "node": "node-switch", "port": "port-switch-c" },
      "to": { "node": "node-c", "port": "port-c" },
      "metadata": {}
    }
  ]
}

---
import Search from '../components/Search.astro'
import '../styles/global.css'

interface Props {
  title: string
  description: string
  lang: 'en' | 'ja'
}

const { title, description, lang } = Astro.props
const alternatePath =
  lang === 'en'
    ? Astro.url.pathname.replace(/^\/en/, '/ja')
    : Astro.url.pathname.replace(/^\/ja/, '/en')
const labels =
  lang === 'en'
    ? {
        home: 'Overview',
        guide: 'Getting started',
        reference: 'YAML reference',
        api: 'Core API',
        alternate: '日本語',
      }
    : {
        home: '概要',
        guide: 'はじめに',
        reference: 'YAMLリファレンス',
        api: 'Core API',
        alternate: 'English',
      }
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width">
    <meta name="description" content={description}>
    <title>{title} · Shumoku Docs</title>
  </head>
  <body>
    <header>
      <a class="brand" href={`/${lang}/`}>Shumoku <span>Docs</span></a>
      <nav aria-label="Primary">
        <a href={`/${lang}/`}>{labels.home}</a>
        <a href={`/${lang}/guides/getting-started`}>{labels.guide}</a>
        <a href={`/${lang}/reference/yaml`}>{labels.reference}</a>
        <a href={alternatePath}>{labels.alternate}</a>
      </nav>
    </header>
    <div class="shell">
      <aside>
        <Search />
        <nav aria-label="Documentation">
          <a href={`/${lang}/guides/getting-started`}>{labels.guide}</a>
          <a href={`/${lang}/reference/yaml`}>{labels.reference}</a>
          <a href={`/${lang}/reference/core/computeNetworkLayout`}>{labels.api}</a>
        </nav>
      </aside>
      <main data-pagefind-body><slot /></main>
    </div>
    <footer>Shumoku documentation · AGPL-3.0-only</footer>
  </body>
</html>

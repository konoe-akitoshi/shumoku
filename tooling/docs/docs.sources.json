{
  "schemaVersion": 1,
  "sources": [
    {
      "id": "core-api",
      "kind": "typedoc",
      "source": "libs/@shumoku/core/src/index.ts",
      "generated": "apps/docs/.generated/core.json"
    },
    {
      "id": "server-api",
      "kind": "openapi",
      "source": "apps/server/api/openapi.json",
      "generated": "apps/docs/.generated/server.json"
    },
    {
      "id": "cli",
      "kind": "command-model",
      "source": "apps/cli/src/command.ts",
      "generated": "apps/docs/.generated/cli.json"
    },
    {
      "id": "yaml-schema",
      "kind": "runtime-schema",
      "source": "libs/@shumoku/core/src/parser/parser.ts",
      "inputs": ["examples/getting-started.yaml"],
      "generated": "apps/docs/.generated/yaml.json"
    }
  ]
}

{
  "schemaVersion": "0.1.0-draft",
  "id": "network-campus",
  "nodes": [
    {
      "id": "node-router",
      "name": "edge-router",
      "attributes": { "device.role": "router" }
    },
    {
      "id": "node-switch",
      "name": "access-switch",
      "attributes": { "device.role": "switch" }
    }
  ],
  "ports": [
    {
      "id": "port-router-uplink",
      "nodeId": "node-router",
      "interfaceName": "ge-0/0/0"
    },
    {
      "id": "port-switch-uplink",
      "nodeId": "node-switch",
      "interfaceName": "Ethernet1"
    }
  ],
  "connections": [
    {
      "id": "connection-uplink",
      "endpoints": [{ "portId": "port-router-uplink" }, { "portId": "port-switch-uplink" }],
      "attributes": { "connection.technology": "ethernet" }
    }
  ],
  "groups": [
    { "id": "group-campus", "name": "Campus", "nodeIds": ["node-router", "node-switch"] },
    { "id": "group-trusted", "name": "Trusted zone", "nodeIds": ["node-router", "node-switch"] }
  ]
}

{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": ["dist/**", ".next/**", ".svelte-kit/**", ".vercel/output/**", "build/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "test": {
      "dependsOn": ["build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"]
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "@shumoku/website#build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*", "../../tooling/docs/migration.routes.json"],
      "outputs": [".svelte-kit/**", ".vercel/output/**"]
    },
    "@shumoku/docs#build": {
      "cache": false,
      "dependsOn": ["^build", "@shumoku/plugin-sdk#build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": ["dist/**"]
    },
    "@shumoku/docs#typecheck": {
      "cache": false,
      "dependsOn": ["^build", "@shumoku/plugin-sdk#build"]
    }
  }
}

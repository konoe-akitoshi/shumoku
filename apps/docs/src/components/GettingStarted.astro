---
import DocsLayout from '../layouts/DocsLayout.astro'
import { loadServerVersions } from '../lib/docs-model'
import { serverVersionPath } from '../lib/server-version'

interface Props {
  lang: 'en' | 'ja'
}

const { lang } = Astro.props
const serverPath = serverVersionPath(await loadServerVersions(), lang)
const labels =
  lang === 'en'
    ? {
        title: 'Getting started',
        description: 'Choose how you want to use Shumoku.',
        intro: 'Shumoku provides a library, a CLI, a monitoring Server, and a visual Editor.',
        library: 'Library',
        libraryDescription: 'Build topology generation into a TypeScript application.',
        cli: 'CLI',
        cliDescription: 'Render YAML or JSON topology files from a terminal or CI.',
        server: 'Server',
        serverDescription: 'Deploy topology-based monitoring and connect live data sources.',
        editor: 'Editor',
        editorDescription: 'Design topologies visually in the separate Editor application.',
        playground: 'Playground',
        playgroundDescription: 'Try Shumoku without installing anything.',
      }
    : {
        title: 'はじめに',
        description: 'Shumokuをどの形で利用するか選びます。',
        intro: 'Shumokuにはライブラリ、CLI、監視Server、ビジュアルEditorがあります。',
        library: 'ライブラリ',
        libraryDescription: 'TypeScriptアプリケーションへトポロジー生成を組み込みます。',
        cli: 'CLI',
        cliDescription: 'YAMLまたはJSONをterminalやCIから描画します。',
        server: 'Server',
        serverDescription: 'トポロジー監視環境を構築し、実データソースを接続します。',
        editor: 'Editor',
        editorDescription: '独立したEditorアプリでトポロジーを視覚的に設計します。',
        playground: 'Playground',
        playgroundDescription: 'インストールせずにShumokuを試します。',
      }
---

<DocsLayout lang={lang} title={labels.title} description={labels.description}>
  <h1>{labels.title}</h1>
  <p class="lead">{labels.intro}</p>
  <div class="cards">
    <a class="card" href={`/${lang}/library`}>
      <strong>{labels.library}</strong><br>{labels.libraryDescription}
    </a>
    <a class="card" href={`/${lang}/cli`}>
      <strong>{labels.cli}</strong><br>{labels.cliDescription}
    </a>
    <a class="card" href={serverPath}>
      <strong>{labels.server}</strong><br>{labels.serverDescription}
    </a>
    <a class="card" href="https://editor.shumoku.dev/">
      <strong>{labels.editor}</strong><br>{labels.editorDescription}
    </a>
    <a class="card" href="https://www.shumoku.dev/">
      <strong>{labels.playground}</strong><br>{labels.playgroundDescription}
    </a>
  </div>
</DocsLayout>

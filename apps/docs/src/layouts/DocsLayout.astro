---
import Search from '../components/Search.astro'
import '../styles/global.css'

interface Props {
  title: string
  description: string
  lang: 'en' | 'ja'
}

const { title, description, lang } = Astro.props
const canonicalUrl = new URL(Astro.url.pathname, Astro.site)
const alternatePath =
  lang === 'en'
    ? Astro.url.pathname.replace(/^\/en/, '/ja')
    : Astro.url.pathname.replace(/^\/ja/, '/en')
const labels =
  lang === 'en'
    ? {
        home: 'Overview',
        guide: 'Getting started',
        reference: 'YAML reference',
        api: 'Core API',
        serverApi: 'Server API',
        plugins: 'Plugins',
        serverGuide: 'Server guides',
        cli: 'CLI',
        alternate: '日本語',
      }
    : {
        home: '概要',
        guide: 'はじめに',
        reference: 'YAMLリファレンス',
        api: 'Core API',
        serverApi: 'Server API',
        plugins: 'Plugins',
        serverGuide: 'Serverガイド',
        cli: 'CLI',
        alternate: 'English',
      }
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width">
    <meta name="description" content={description}>
    <link rel="canonical" href={canonicalUrl}>
    <link
      rel="alternate"
      hreflang={lang === 'en' ? 'ja' : 'en'}
      href={new URL(alternatePath, Astro.site)}
    >
    <link rel="alternate" hreflang={lang} href={canonicalUrl}>
    <title>{title} · Shumoku Docs</title>
  </head>
  <body>
    <header>
      <a class="brand" href={`/${lang}/`}>Shumoku <span>Docs</span></a>
      <nav aria-label="Primary">
        <a href={`/${lang}/`}>{labels.home}</a>
        <a href={`/${lang}/guides/getting-started`}>{labels.guide}</a>
        <a href={`/${lang}/reference/yaml`}>{labels.reference}</a>
        <a href={alternatePath}>{labels.alternate}</a>
      </nav>
    </header>
    <div class="shell">
      <aside>
        <Search />
        <nav aria-label="Documentation">
          <a href={`/${lang}/guides/getting-started`}>{labels.guide}</a>
          <a href={`/${lang}/reference/yaml`}>{labels.reference}</a>
          <a href={`/${lang}/reference/core`}>{labels.api}</a>
          <a href={`/${lang}/reference/server`}>{labels.serverApi}</a>
          <a href={`/${lang}/reference/plugins`}>{labels.plugins}</a>
          <a href={`/${lang}/guides/server`}>{labels.serverGuide}</a>
          <a href={`/${lang}/reference/cli/render`}>{labels.cli}</a>
        </nav>
      </aside>
      <main data-pagefind-body data-pagefind-filter={`language:${lang}`}><slot /></main>
    </div>
    <footer>Shumoku documentation · AGPL-3.0-only</footer>
  </body>
</html>

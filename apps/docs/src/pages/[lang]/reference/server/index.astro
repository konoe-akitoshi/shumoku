---
import ServerApiIndex from '../../../../components/reference/ServerApiIndex.astro'
import DocsLayout from '../../../../layouts/DocsLayout.astro'
import { loadServerReference } from '../../../../lib/docs-model'

export async function getStaticPaths() {
  const model = await loadServerReference()
  return (['en', 'ja'] as const).map((lang) => ({ params: { lang }, props: { lang, model } }))
}

const { lang, model } = Astro.props
const title = lang === 'en' ? 'Server API' : 'Server APIリファレンス'
const description =
  lang === 'en'
    ? `${model.operations.length} operations generated from the OpenAPI contract.`
    : `OpenAPI契約から生成した ${model.operations.length} 件の操作です。`
---

<DocsLayout lang={lang} title={title} description={description}>
  <ServerApiIndex lang={lang} model={model} basePath={`/${lang}/reference/server`} />
</DocsLayout>

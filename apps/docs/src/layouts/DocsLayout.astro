---
import Search from '../components/Search.astro'
import { loadRepositoryDocs, loadServerVersions } from '../lib/docs-model'
import { docsNavigation, docsSections } from '../lib/navigation'
import { localizedPage, repositoryPagePath } from '../lib/repository-docs'
import {
  correspondingServerPage,
  type ServerVersionContext,
  serverVersionPath,
} from '../lib/server-version'
import '../styles/global.css'

interface Props {
  title: string
  description: string
  lang: 'en' | 'ja'
  server?: ServerVersionContext
  canonicalPath?: string
  searchable?: boolean
}

const { title, description, lang, server, canonicalPath, searchable = true } = Astro.props
const canonicalUrl = new URL(canonicalPath ?? Astro.url.pathname, Astro.site)
const alternatePath =
  lang === 'en'
    ? Astro.url.pathname.replace(/^\/en/, '/ja')
    : Astro.url.pathname.replace(/^\/ja/, '/en')
const labels =
  lang === 'en'
    ? {
        alternate: '日本語',
        prerelease: 'This documentation describes a prerelease Server build.',
        development: 'This documentation was generated from unreleased source.',
        versions: 'Server versions',
        policies: 'Project policies',
      }
    : {
        alternate: 'English',
        prerelease: 'このドキュメントはServerのプレリリース版を対象としています。',
        development: 'このドキュメントは未リリースのsourceから生成されています。',
        versions: 'Serverバージョン',
        policies: 'プロジェクトポリシー',
      }
const versions = await loadServerVersions()
const repositoryDocs = await loadRepositoryDocs()
const serverEntry = server
  ? `/${lang}/server/${server.routeVersion}`
  : serverVersionPath(versions, lang)
const serverArtifact = server
  ? versions.versions.find(({ release }) => release.version === server.routeVersion)
  : undefined
const navigation = docsNavigation(Astro.url.pathname, lang, repositoryDocs, serverArtifact)
const sections = docsSections(lang, serverEntry)
const activeSection =
  sections.find(({ pathPrefixes }) =>
    pathPrefixes.some(
      (prefix) => Astro.url.pathname === prefix || Astro.url.pathname.startsWith(`${prefix}/`),
    ),
  ) ?? sections[0]
const policyPages = repositoryDocs.pages.filter(
  ({ kind, publication }) => kind === 'policy' && publication !== 'private',
)
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width">
    <meta name="description" content={description}>
    {server && <meta data-pagefind-filter={`server-version:${server.routeVersion}`} />}
    <link rel="canonical" href={canonicalUrl}>
    <link
      rel="alternate"
      hreflang={lang === 'en' ? 'ja' : 'en'}
      href={new URL(alternatePath, Astro.site)}
    >
    <link rel="alternate" hreflang={lang} href={canonicalUrl}>
    <title>{title} · Shumoku Docs</title>
  </head>
  <body>
    <header>
      <a class="brand" href={`/${lang}`}>Shumoku <span>Docs</span></a>
      <nav aria-label="Primary">
        {sections.map((section) => <a href={section.href}>{section.label}</a>)}
        <a href={alternatePath}>{labels.alternate}</a>
      </nav>
    </header>
    <div class="shell">
      <aside>
        <details class="section-switcher">
          <summary>
            <span>{lang === 'en' ? 'Documentation' : 'ドキュメント'}</span>
            <strong>{activeSection.label}</strong>
          </summary>
          <nav aria-label={lang === 'en' ? 'Documentation sections' : 'ドキュメント大項目'}>
            {sections.map((section) => (
              <a
                href={section.href}
                aria-current={section === activeSection ? 'page' : undefined}
              >
                {section.label}
              </a>
            ))}
          </nav>
        </details>
        <Search lang={lang} serverVersion={server?.routeVersion} />
        <nav aria-label="Documentation">
          {navigation.map(
            (group) =>
              group.links.length > 0 && (
                <section class="nav-group">
                  <p class="nav-section">{group.label}</p>
                  <div class="nav-group-links">
                    {group.links.map((link) => (
                      <a
                        href={link.href}
                        aria-current={Astro.url.pathname === link.href ? 'page' : undefined}
                      >
                        {link.label}
                      </a>
                    ))}
                  </div>
                </section>
              ),
          )}
        </nav>
      </aside>
      <main
        data-pagefind-body
        data-pagefind-ignore={searchable ? undefined : true}
        data-pagefind-filter={server
          ? `search-scope:${server.routeVersion === versions.aliases.latest || (!versions.aliases.latest && server.routeVersion === versions.aliases.beta) ? 'default' : server.channel === 'stable' ? 'archive' : 'prerelease'}`
          : 'search-scope:default'}
      >
        {server && (
          <div class:list={['version-banner', { prerelease: server.channel !== 'stable' }]}>
            <div>
              <strong>Server {server.productVersion}</strong>
              {server.channel === 'beta' && <span>{labels.prerelease}</span>}
              {server.channel === 'development' && <span>{labels.development}</span>}
            </div>
            <details>
              <summary>{labels.versions}</summary>
              <nav aria-label={labels.versions}>
                {versions.versions.map((target) => (
                  <a href={serverArtifact ? correspondingServerPage(Astro.url.pathname, lang, serverArtifact, target) : `/${lang}/server/${target.release.version}`}>
                    {target.release.version === 'next' ? 'next' : target.release.productVersion}
                    {target.release.channel === 'beta' ? ' · beta' : ''}
                  </a>
                ))}
              </nav>
            </details>
          </div>
        )}
        <slot />
      </main>
    </div>
    <footer>
      <span>Shumoku documentation · AGPL-3.0-only</span>
      {policyPages.length > 0 && (
        <nav aria-label={labels.policies}>
          {policyPages.map((page) => (
            <a href={repositoryPagePath(page, lang)}>{localizedPage(page, lang).title}</a>
          ))}
        </nav>
      )}
    </footer>
  </body>
</html>

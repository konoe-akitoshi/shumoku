---
import PluginDetail from '../../../../components/reference/PluginDetail.astro'
import DocsLayout from '../../../../layouts/DocsLayout.astro'
import { loadPluginsReference, type PluginReference } from '../../../../lib/docs-model'

export async function getStaticPaths() {
  const model = await loadPluginsReference()
  return model.plugins.flatMap((plugin) =>
    (['en', 'ja'] as const).map((lang) => ({
      params: { lang, plugin: plugin.type },
      props: { lang, plugin },
    })),
  )
}

interface Props {
  lang: 'en' | 'ja'
  plugin: PluginReference
}

const { lang, plugin } = Astro.props
---

<DocsLayout
  lang={lang}
  title={plugin.displayName}
  description={plugin.description || `${plugin.displayName} data source plugin`}
>
  <PluginDetail lang={lang} plugin={plugin} />
</DocsLayout>

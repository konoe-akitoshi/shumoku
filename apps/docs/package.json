{
  "name": "@shumoku/docs",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "docs:generate": "bun --cwd ../../tooling/docs generate",
    "build": "bun run docs:generate && astro build && pagefind --site dist",
    "check": "bun run build && bun --cwd ../../tooling/docs check",
    "dev": "bun run docs:generate && astro dev",
    "preview": "astro preview",
    "typecheck": "bun run docs:generate && astro check",
    "lint": "biome check .",
    "format": "biome check --write ."
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^6.3.11",
    "astro": "^5.13.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "@biomejs/biome": "^2.4.8",
    "@shumoku/docs-tooling": "workspace:*",
    "pagefind": "^1.4.0",
    "typescript": "^5.9.3"
  }
}

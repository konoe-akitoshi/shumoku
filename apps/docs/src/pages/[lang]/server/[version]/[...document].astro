---
import DocsLayout from '../../../../layouts/DocsLayout.astro'
import {
  loadRepositoryDocs,
  loadServerVersions,
  type RepositoryDocsModel,
  type RepositoryPage,
  type ServerDocsArtifact,
  type ServerVersionsModel,
} from '../../../../lib/docs-model'
import { localizedPage, renderRepositoryPage } from '../../../../lib/repository-docs'
import { versionContext } from '../../../../lib/server-version'

export async function getStaticPaths() {
  const model = await loadServerVersions()
  const repositoryDocs = await loadRepositoryDocs()
  return model.versions.flatMap((artifact) =>
    artifact.pages
      .filter(({ route, publication }) => route !== 'overview' && publication !== 'private')
      .flatMap((page) =>
        (['en', 'ja'] as const).map((lang) => ({
          params: { lang, version: artifact.release.version, document: page.route },
          props: { lang, artifact, page, model, repositoryDocs },
        })),
      ),
  )
}

interface Props {
  lang: 'en' | 'ja'
  artifact: ServerDocsArtifact
  page: RepositoryPage
  model: ServerVersionsModel
  repositoryDocs: RepositoryDocsModel
}

const { lang, artifact, page, model, repositoryDocs } = Astro.props
const server = versionContext(artifact, model)
const renderPages = [
  ...repositoryDocs.pages.filter(({ owner }) => owner !== 'server'),
  ...artifact.pages,
]
const localized = localizedPage(page, lang)
const rendered = await renderRepositoryPage(
  page,
  renderPages,
  lang,
  artifact.release.tag ?? artifact.release.sourceCommit,
  { serverVersion: artifact.release.version, stripTitle: true },
)
---

<DocsLayout lang={lang} title={localized.title} description={localized.description} server={server}>
  <p class="eyebrow">{localized.source.file}</p>
  <h1>{localized.title}</h1>
  <p class="lead">{localized.description}</p>
  {localized.fallback && (
    <p class="language-note">
      {lang === 'ja'
        ? 'この文書の日本語版はまだありません。原文を表示しています。'
        : 'This document is currently available in Japanese only.'}
    </p>
  )}
  <article class="markdown-body repository-document" set:html={rendered} />
</DocsLayout>

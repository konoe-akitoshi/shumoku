{
  "name": "@shumoku/website",
  "private": true,
  "version": "0.2.25",
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "vite dev --host 127.0.0.1",
    "build": "svelte-kit sync && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "lint": "biome check .",
    "test": "vitest run src/lib"
  },
  "dependencies": {
    "@lucide/svelte": "^1.41.0",
    "@shumoku/core": "workspace:*",
    "@shumoku/renderer": "workspace:*",
    "@shumoku/renderer-html": "workspace:*",
    "@shumoku/renderer-svg": "workspace:*",
    "@shumoku/site-i18n": "workspace:*",
    "@shumoku/website-content": "workspace:*",
    "@vercel/analytics": "^2.0.1",
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.6.0",
    "vanilla-cookieconsent": "3.1.0"
  },
  "devDependencies": {
    "vitest": "^4.0.17",
    "@sveltejs/adapter-vercel": "^6.3.3",
    "@sveltejs/kit": "^2.15.2",
    "@sveltejs/vite-plugin-svelte": "^5.0.3",
    "@tailwindcss/vite": "^4.3.3",
    "svelte": "^5.17.3",
    "svelte-check": "^4.1.4",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^6.4.1"
  }
}

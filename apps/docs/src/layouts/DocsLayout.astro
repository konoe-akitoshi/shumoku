---
import Search from '../components/Search.astro'
import { loadRepositoryDocs, loadServerVersions } from '../lib/docs-model'
import { repositoryDocumentPath } from '../lib/repository-docs'
import { type ServerVersionContext, serverEntryPath } from '../lib/server-version'
import '../styles/global.css'

interface Props {
  title: string
  description: string
  lang: 'en' | 'ja'
  server?: ServerVersionContext
  canonicalPath?: string
}

const { title, description, lang, server, canonicalPath } = Astro.props
const canonicalUrl = new URL(canonicalPath ?? Astro.url.pathname, Astro.site)
const alternatePath =
  lang === 'en'
    ? Astro.url.pathname.replace(/^\/en/, '/ja')
    : Astro.url.pathname.replace(/^\/ja/, '/en')
const labels =
  lang === 'en'
    ? {
        home: 'Overview',
        guide: 'Get started',
        library: 'Library',
        yaml: 'Topology YAML',
        api: 'TypeScript API',
        server: 'Server',
        serverApi: 'Server API',
        plugins: 'Data sources',
        cli: 'CLI',
        cliCommands: 'Commands',
        alternate: '日本語',
        prerelease: 'This documentation describes a prerelease Server build.',
        development: 'This documentation was generated from unreleased source.',
        versions: 'Server versions',
        about: 'About',
        developers: 'Developers',
        community: 'Community',
        project: 'Project',
      }
    : {
        home: '概要',
        guide: 'はじめに',
        library: 'ライブラリ',
        yaml: 'Topology YAML',
        api: 'TypeScript API',
        server: 'Server',
        serverApi: 'Server API',
        plugins: 'Data Source',
        cli: 'CLI',
        cliCommands: 'コマンド',
        alternate: 'English',
        prerelease: 'このドキュメントはServerのプレリリース版を対象としています。',
        development: 'このドキュメントは未リリースのsourceから生成されています。',
        versions: 'Serverバージョン',
        about: 'Shumokuについて',
        developers: '開発者向け',
        community: 'コミュニティ',
        project: 'プロジェクト',
      }
const versions = await loadServerVersions()
const repositoryDocs = await loadRepositoryDocs()
const serverBase = server
  ? `/${lang}/server/${server.routeVersion}`
  : serverEntryPath(versions, lang)
const serverEntry = server ? serverBase : serverEntryPath(versions, lang)
const projectDocuments = repositoryDocs.documents.filter(
  ({ owner, route }) => owner === 'project' && route !== 'overview',
)
const libraryDocuments = repositoryDocs.documents.filter(
  ({ owner, route }) => owner === 'library' && route !== 'overview',
)
const groupedProjectDocuments = ['about', 'developers', 'community', 'project'].map((group) => ({
  group,
  documents: projectDocuments.filter(({ route }) => route.startsWith(`${group}/`)),
}))
const serverArtifact = server
  ? versions.versions.find(({ release }) => release.version === server.routeVersion)
  : undefined
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width">
    <meta name="description" content={description}>
    <link rel="canonical" href={canonicalUrl}>
    <link
      rel="alternate"
      hreflang={lang === 'en' ? 'ja' : 'en'}
      href={new URL(alternatePath, Astro.site)}
    >
    <link rel="alternate" hreflang={lang} href={canonicalUrl}>
    <title>{title} · Shumoku Docs</title>
  </head>
  <body>
    <header>
      <a class="brand" href={`/${lang}`}>Shumoku <span>Docs</span></a>
      <nav aria-label="Primary">
        <a href={`/${lang}`}>{labels.home}</a>
        <a href={`/${lang}/getting-started`}>{labels.guide}</a>
        <a href={`/${lang}/library`}>{labels.library}</a>
        <a href={`/${lang}/cli`}>{labels.cli}</a>
        <a href={serverEntry}>{labels.server}</a>
        <a href={alternatePath}>{labels.alternate}</a>
      </nav>
    </header>
    <div class="shell">
      <aside>
        <Search lang={lang} serverVersion={server?.routeVersion} />
        <nav aria-label="Documentation">
          <a href={`/${lang}/getting-started`}>{labels.guide}</a>
          <p class="nav-section">{labels.library}</p>
          <a href={`/${lang}/library`}>{labels.library}</a>
          <a href={`/${lang}/library/yaml`}>{labels.yaml}</a>
          <a href={`/${lang}/library/api`}>{labels.api}</a>
          {libraryDocuments.map((document) => (
            <a href={repositoryDocumentPath(document, lang)}>{document.title}</a>
          ))}
          <p class="nav-section">{labels.cli}</p>
          <a href={`/${lang}/cli`}>{labels.cli}</a>
          <a href={`/${lang}/cli/commands/render`}>{labels.cliCommands}</a>
          {serverBase && (
            <>
              <p class="nav-section">{labels.server}</p>
              <a href={serverEntry}>{labels.server}</a>
              <a href={`${serverBase}/api`}>{labels.serverApi}</a>
              <a href={`${serverBase}/plugins`}>{labels.plugins}</a>
              {serverArtifact?.documents.filter(({ route }) => route !== 'overview').map((document) => (
                <a href={`${serverBase}/${document.route}`}>{document.title}</a>
              ))}
            </>
          )}
          {groupedProjectDocuments.map(({ group, documents }) => (
            documents.length > 0 && (
              <>
                <p class="nav-section">{labels[group as keyof typeof labels]}</p>
                {documents.map((document) => (
                  <a href={repositoryDocumentPath(document, lang)}>{document.title}</a>
                ))}
              </>
            )
          ))}
        </nav>
      </aside>
      <main
        data-pagefind-body
        data-pagefind-filter={server
          ? `language:${lang}, server-version:${server.routeVersion}, search-scope:${server.channel === 'stable' ? 'default' : 'prerelease'}`
          : `language:${lang}, search-scope:default`}
      >
        {server && (
          <div class:list={['version-banner', { prerelease: server.channel !== 'stable' }]}>
            <div>
              <strong>Server {server.productVersion}</strong>
              {server.channel === 'beta' && <span>{labels.prerelease}</span>}
              {server.channel === 'development' && <span>{labels.development}</span>}
            </div>
            <details>
              <summary>{labels.versions}</summary>
              <nav aria-label={labels.versions}>
                {server.versions.map((version) => (
                  <a href={`/${lang}/server/${version.routeVersion}`}>
                    {version.routeVersion === 'next' ? 'next' : version.productVersion}
                    {version.channel === 'beta' ? ' · beta' : ''}
                  </a>
                ))}
              </nav>
            </details>
          </div>
        )}
        <slot />
      </main>
    </div>
    <footer>Shumoku documentation · AGPL-3.0-only</footer>
  </body>
</html>

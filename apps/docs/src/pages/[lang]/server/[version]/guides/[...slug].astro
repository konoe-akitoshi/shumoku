---
import DocsLayout from '../../../../../layouts/DocsLayout.astro'
import {
  loadServerVersions,
  type ServerDocsArtifact,
  type ServerGuideArtifact,
  type ServerVersionsModel,
} from '../../../../../lib/docs-model'
import {
  guideRouteSlug,
  renderVersionedGuide,
  versionContext,
} from '../../../../../lib/server-version'

export async function getStaticPaths() {
  const model = await loadServerVersions()
  return model.versions.flatMap((artifact) =>
    artifact.guides.map((guide) => ({
      params: {
        lang: guide.locale,
        version: artifact.release.version,
        slug: guideRouteSlug(guide),
      },
      props: { artifact, guide, model },
    })),
  )
}

interface Props {
  artifact: ServerDocsArtifact
  guide: ServerGuideArtifact
  model: ServerVersionsModel
}

const { artifact, guide, model } = Astro.props
const server = versionContext(artifact, model)
const rendered = await renderVersionedGuide(guide.body, guide.locale, artifact.release.version)
---

<DocsLayout
  lang={guide.locale}
  title={guide.title}
  description={guide.description}
  server={server}
  searchable={guide.id !== 'server.overview'}
>
  <p class="eyebrow">{guide.owner} · {guide.status}</p>
  <h1>{guide.title}</h1>
  <p class="lead">{guide.description}</p>
  <div class="markdown-body" set:html={rendered} />
</DocsLayout>

---
import DocsFooter from '../components/DocsFooter.astro'
import DocsHeader from '../components/DocsHeader.astro'
import DocsSidebar from '../components/DocsSidebar.astro'
import VersionNotice from '../components/VersionNotice.astro'
import { loadRepositoryDocs, loadServerVersions } from '../lib/docs-model'
import { docsNavigation, docsSections } from '../lib/navigation'
import { localizedPage, repositoryPagePath } from '../lib/repository-docs'
import {
  correspondingServerPage,
  type ServerVersionContext,
  serverVersionPath,
} from '../lib/server-version'
import '../styles/global.css'

interface Props {
  title: string
  description: string
  lang: 'en' | 'ja'
  server?: ServerVersionContext
  canonicalPath?: string
  searchable?: boolean
}

const { title, description, lang, server, canonicalPath, searchable = true } = Astro.props
const canonicalUrl = new URL(canonicalPath ?? Astro.url.pathname, Astro.site)
const alternatePath =
  lang === 'en'
    ? Astro.url.pathname.replace(/^\/en/, '/ja')
    : Astro.url.pathname.replace(/^\/ja/, '/en')
const versions = await loadServerVersions()
const repositoryDocs = await loadRepositoryDocs()
const serverEntry = server
  ? `/${lang}/server/${server.routeVersion}`
  : serverVersionPath(versions, lang)
const serverArtifact = server
  ? versions.versions.find(({ release }) => release.version === server.routeVersion)
  : undefined
const navigation = docsNavigation(Astro.url.pathname, lang, repositoryDocs, serverArtifact)
const sections = docsSections(lang, serverEntry)
const activeSection =
  sections.find(({ pathPrefixes }) =>
    pathPrefixes.some(
      (prefix) => Astro.url.pathname === prefix || Astro.url.pathname.startsWith(`${prefix}/`),
    ),
  ) ?? sections[0]
const policyPages = repositoryDocs.pages.filter(
  ({ kind, publication }) => kind === 'policy' && publication !== 'private',
)
const versionPicker = server
  ? {
      label: server.routeVersion === 'next' ? 'Server · next' : `Server · ${server.productVersion}`,
      links: versions.versions.map((target) => ({
        label: target.release.version === 'next' ? 'next' : target.release.productVersion,
        href: serverArtifact
          ? correspondingServerPage(Astro.url.pathname, lang, serverArtifact, target)
          : `/${lang}/server/${target.release.version}`,
        current: target.release.version === server.routeVersion,
      })),
    }
  : undefined
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width">
    <meta name="description" content={description}>
    {server && <meta data-pagefind-filter={`server-version:${server.routeVersion}`} />}
    <link rel="canonical" href={canonicalUrl}>
    <link
      rel="alternate"
      hreflang={lang === 'en' ? 'ja' : 'en'}
      href={new URL(alternatePath, Astro.site)}
    >
    <link rel="alternate" hreflang={lang} href={canonicalUrl}>
    <title>{title} · Shumoku Docs</title>
  </head>
  <body>
    <a class="skip-link" href="#main-content"
      >{lang === 'ja' ? '本文へスキップ' : 'Skip to content'}</a
    >
    <DocsHeader lang={lang} alternatePath={alternatePath} serverVersion={server?.routeVersion} />
    <div class="shell">
      <DocsSidebar
        lang={lang}
        pathname={Astro.url.pathname}
        activeSection={activeSection}
        sections={sections.map((section) => ({ ...section, current: section === activeSection }))}
        items={navigation}
        version={versionPicker}
      />
      <main
        id="main-content"
        tabindex="-1"
        data-pagefind-body
        data-pagefind-ignore={searchable ? undefined : true}
        data-pagefind-filter={server
          ? `search-scope:${server.routeVersion === versions.aliases.latest || (!versions.aliases.latest && server.routeVersion === versions.aliases.beta) ? 'default' : server.channel === 'stable' ? 'archive' : 'prerelease'}`
          : 'search-scope:default'}
      >
        {server && <VersionNotice lang={lang} channel={server.channel} />}
        <slot />
      </main>
    </div>
    <DocsFooter
      lang={lang}
      links={policyPages.map((page) => ({ href: repositoryPagePath(page, lang), label: localizedPage(page, lang).title }))}
    />
  </body>
</html>

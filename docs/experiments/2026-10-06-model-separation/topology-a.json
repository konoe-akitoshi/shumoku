{
  "id": "network-campus",
  "version": "1.0",
  "nodes": [
    {
      "id": "node-router",
      "label": "edge-router",
      "metadata": { "device.role": "router" },
      "ports": [{ "id": "port-router-uplink", "label": "ge-0/0/0", "interfaceName": "ge-0/0/0" }]
    },
    {
      "id": "node-switch",
      "label": "access-switch",
      "metadata": { "device.role": "switch" },
      "ports": [{ "id": "port-switch-uplink", "label": "Ethernet1", "interfaceName": "Ethernet1" }]
    }
  ],
  "links": [
    {
      "id": "connection-uplink",
      "from": { "node": "node-router", "port": "port-router-uplink" },
      "to": { "node": "node-switch", "port": "port-switch-uplink" },
      "metadata": { "connection.technology": "ethernet" }
    }
  ]
}

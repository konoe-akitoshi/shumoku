---
import RedirectPage from '../../../../components/RedirectPage.astro'

export function getStaticPaths() {
  return (['en', 'ja'] as const).map((lang) => ({ params: { lang }, props: { lang } }))
}

const { lang } = Astro.props
---

<RedirectPage lang={lang} destination={`/${lang}/library/api`} title="TypeScript API" />

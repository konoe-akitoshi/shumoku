---
import ServerApiOperation from '../../../../components/reference/ServerApiOperation.astro'
import DocsLayout from '../../../../layouts/DocsLayout.astro'
import { type ApiOperation, loadServerReference } from '../../../../lib/docs-model'

interface Props {
  lang: 'en' | 'ja'
  operation: ApiOperation
  apiTitle: string
  apiVersion: string
}

export async function getStaticPaths() {
  const model = await loadServerReference()
  return model.operations.flatMap((operation) =>
    (['en', 'ja'] as const).map((lang) => ({
      params: { lang, operation: operation.id },
      props: {
        lang,
        operation,
        apiTitle: model.api.title,
        apiVersion: model.api.version,
      },
    })),
  )
}

const { lang, operation, apiTitle, apiVersion } = Astro.props
---

<DocsLayout lang={lang} title={operation.summary} description={operation.summary}>
  <ServerApiOperation
    lang={lang}
    operation={operation}
    apiTitle={apiTitle}
    apiVersion={apiVersion}
  />
</DocsLayout>
